# ── Database (Neon) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/openbooks?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/openbooks?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-npx-auth-secret-or-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ── OAuth ────────────────────────────────────────────────────────────
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Email verification (Resend) ─────────────────────────────────────
# Create a Resend account, verify your sending domain, then add these.
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="OpenBooks <verify@your-verified-domain.com>"

# ── App ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Cron ─────────────────────────────────────────────────────────────
# CRON_SECRET="generate-random-32"

# ── Storage (optional Vercel Blob) ──────────────────────────────────
# BLOB_READ_WRITE_TOKEN=""

# NOTE: Paystack is intentionally deferred from V1.
