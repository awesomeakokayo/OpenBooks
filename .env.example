# OpenBooks — Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to Git.

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────────
# Generate a strong secret with: npx auth secret
AUTH_SECRET="generate-a-strong-random-secret"
# Local development: http://localhost:3000
# Production canonical URL: https://www.openbooks.click
# Keep AUTH_URL aligned with the exact hostname configured for OAuth.
AUTH_URL="http://localhost:3000"

# Auth.js v5 provider variables.
# Local + production callback path is /api/auth/callback/<provider>.
# Google:  http://localhost:3000/api/auth/callback/google
# GitHub:  http://localhost:3000/api/auth/callback/github
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Optional legacy variable names are accepted by the application for easier
# migration from older deployments. Prefer the AUTH_* names above.
# GITHUB_ID="your-github-client-id"
# GITHUB_SECRET="your-github-client-secret"
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Email verification / password reset (Resend) ──────────────────
# Verify a sending domain in your email provider and use a sender address
# on that verified domain for production.
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="OpenBooks <noreply@example.com>"

# ── Distributed rate limiting (optional at current scale) ─────────
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ── Application ────────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production canonical URL: https://www.openbooks.click
APP_URL="http://localhost:3000"

# ── Analytics ──────────────────────────────────────────────────────
# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Comma-separated email address(es) allowed to view /admin/analytics.
# Keep this server-only variable out of NEXT_PUBLIC_*.
OPENBOOKS_ADMIN_EMAILS="you@example.com"

# ── Cron / scheduled jobs ─────────────────────────────────────────
# CRON_SECRET="generate-a-strong-random-secret"

# ── Storage (optional) ────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=""

# ── Payments ──────────────────────────────────────────────────────
# Payment-provider credentials are server-only secrets. Add them only to
# your deployment/local secret store when the related feature is enabled.
