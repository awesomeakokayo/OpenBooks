# OpenBooks NG — Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to Git.

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────────
# Generate a strong secret with: npx auth secret
AUTH_SECRET="generate-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# ── Google OAuth ───────────────────────────────────────────────────
# Create OAuth credentials in Google Cloud Console.
# Callback URL for local development:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ── GitHub OAuth ──────────────────────────────────────────────────
# Create an OAuth App in GitHub Developer Settings.
# Callback URL for local development:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ── Email verification / password reset (Resend) ────────────────
# Resend is the transactional email provider used by OpenBooks.
#
# You need:
# 1. A free Resend account.
# 2. A Resend API key beginning with `re_`.
# 3. A sender address for RESEND_FROM_EMAIL.
#
# For production, verify a domain you control in Resend and use an
# address on that verified domain (for example: OpenBooks <noreply@mail.example.com>).
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="OpenBooks <noreply@example.com>"

# ── Distributed rate limiting (Upstash Redis) ─────────────────────
# Required for shared rate-limit state across Vercel/Pxxl instances.
# Create a Redis database in Upstash and copy its REST credentials.
# These are SERVER-ONLY secrets and must never be exposed to the browser.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ── Application ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Cron / scheduled jobs (optional) ─────────────────────────────
# CRON_SECRET="generate-a-strong-random-secret"

# ── Storage (optional) ────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=""

# ── Payments ──────────────────────────────────────────────────────
# Paystack is intentionally DEFERRED from V1.
# Do not add Paystack credentials until the future payment-integration phase.
