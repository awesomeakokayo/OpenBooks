# ── Database (Neon) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/openbooks?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/openbooks?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-npx-auth-secret-or-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ── Optional OAuth (if using all providers) ──────────────────────────
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Paystack (server-only secret) ────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxx"

# ── App ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Storage (optional Vercel Blob) ───────────────────────────────────
