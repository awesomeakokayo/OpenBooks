generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  PAYSTACK
  OTHER
  ONLINE
}

enum PaymentProvider {
  MANUAL
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum VerificationType {
  MANUAL
  AUTOMATIC
}

enum ExpenseCategory {
  TRANSPORT
  MATERIALS
  ELECTRICITY
  RENT
  DATA
  SUPPLIES
  OTHER
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  businesses   Business[]
  memberships  BusinessMember[]
  auditEvents  AuditEvent[] @relation("UserAuditEvents")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Business {
  id                    String   @id @default(cuid())
  ownerId               String
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  phone                 String
  email                 String?
  address               String?
  logoUrl               String?
  description           String?
  currency              String   @default("NGN")
  paystackSubaccountCode String?
  invoiceSequence       Int      @default(0)
  receiptSequence       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members         BusinessMember[]
  paymentSetting  BusinessPaymentSetting?
  customers       Customer[]
  products        Product[]
  invoices        Invoice[]
  sales           Sale[]
  payments        Payment[]
  receipts        Receipt[]
  expenses        Expense[]
  auditEvents     AuditEvent[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMember {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

model BusinessPaymentSetting {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankTransferEnabled   Boolean  @default(true)
  cashEnabled           Boolean  @default(true)
  posEnabled            Boolean  @default(false)
  paystackEnabled       Boolean  @default(false)
  bankName              String?
  accountName           String?
  accountNumber         String?
  updatedAt             DateTime @updatedAt

  @@map("business_payment_settings")
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices Invoice[]
  sales    Sale[]
  payments Payment[]
  receipts Receipt[]

  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("products")
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  publicToken   String        @unique
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items          InvoiceItem[]
  paymentMethods InvoicePaymentMethod[]
  payments       Payment[]
  receipts       Receipt[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePaymentMethod {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    PaymentMethod

  @@unique([invoiceId, method])
  @@map("invoice_payment_methods")
}

model Sale {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description   String
  quantity      Decimal        @db.Decimal(12, 2)
  unitPrice     Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  saleDate      DateTime       @default(now())
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())

  items SaleItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, saleDate])
  @@map("sales")
}

model SaleItem {
  id          String @id @default(cuid())
  saleId      String
  sale        Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id                String           @id @default(cuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("NGN")
  method            PaymentMethod
  provider          PaymentProvider
  status            PaymentStatus
  providerReference String?          @unique
  verificationType  VerificationType
  verifiedAt        DateTime?
  createdAt         DateTime         @default(now())
  metadata          Json?

  receipt Receipt?

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

model Receipt {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentId     String        @unique
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receiptNumber String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@map("receipts")
}

model Expense {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  description   String?         @db.Text
  paymentMethod String?
  expenseDate   DateTime        @default(now())
  createdAt     DateTime        @default(now())

  @@index([businessId])
  @@index([businessId, expenseDate])
  @@map("expenses")
}

model AuditEvent {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation("UserAuditEvents", fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
  @@map("audit_events")
}